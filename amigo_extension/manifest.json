{
  "manifest_version": 3,
  "name": "Automigo AI Quiz Solver",
  "version": "5.2",
  "description": "Automated 10/10 AI Quiz Solver for Amigo LMS — Multi-Provider AI (Ollama, NVIDIA NIM, Groq, Gemini, OpenRouter, OpenAI, OmniRoute)",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://amigo.amityonline.com/*",
    "http://127.0.0.1:20128/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "https://integrate.api.nvidia.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Automigo AI Settings & Control",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://amigo.amityonline.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": ["https://amigo.amityonline.com/*"]
    }
  ]
}
